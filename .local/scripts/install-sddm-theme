#!/usr/bin/env bash
set -euo pipefail

src=$HOME/.dotfiles/.local/share/sddm/themes/rose-pine
dst=/usr/share/sddm/themes/rose-pine

sudo rm -rf "$dst"
sudo cp -r "$src" "$dst"
sudo chmod -R a+rX "$dst"

sudo install -d /etc/sddm.conf.d
printf '[Theme]\nCurrent=rose-pine\n' | sudo tee /etc/sddm.conf.d/theme.conf >/dev/null

echo "installed. preview without logging out:"
echo "  sddm-greeter-qt6 --test-mode --theme $dst"
