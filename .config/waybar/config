{
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "privacy",
    "tray",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "network",
    "custom/separator",
    "custom/vpn",
    "custom/separator",
    "cpu",
    "custom/separator",
    "temperature",
    "custom/separator",
    "bluetooth",
    "custom/separator",
    "hyprland/language"
  ],
  "hyprland/window": {
    "format": "{}",
    "max-length": 60,
    "rewrite": {
      "": "Desktop"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": " "
    },
    "persistent-workspaces": {
      "*": 3
    },
    "sort-by": "number"
  },
  "hyprland/language": {
    "format": "⌨ {}",
    "format-en": "US",
    "format-hr": "HR",
    "keyboard-name": "adv360-pro-keyboard",
    "on-click": "hyprctl switchxkblayout all next",
    "tooltip": false
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%d %m %Y}"
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": false,
    "interval": 3
  },
  "memory": {
    "format": "{}%  "
  },
  "temperature": {
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "",
      "",
      ""
    ],
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "warning-threshold": 70,
    "critical-threshold": 85
  },
  "network": {
    "interface": "wlan0",
    "format": "{ifname}",
    "format-wifi": "  {essid}",
    "format-ethernet": " ",
    "format-disconnected": "Not connected",
    "tooltip-format": "  {ifname} via {gwaddr}",
    "tooltip-format-wifi": "   {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "interval": 10,
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "scroll-step": 5,
    "ignored-sinks": [
      "AT2020USB+ Analog Stereo"
    ]
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-disabled": "",
    "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} ({device_address})\n{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "privacy": {
    "icon-size": 16,
    "icon-spacing": 8,
    "modules": [
      {
        "type": "screenshare"
      },
      {
        "type": "audio-in"
      }
    ]
  },
  "custom/vpn": {
    "exec": "~/.dotfiles/.config/waybar/scripts/vpn-status.sh",
    "restart-interval": 5,
    "return-type": "json",
    "format": "{}",
    "tooltip": true
  },
  "custom/separator": {
    "format": "│",
    "tooltip": false
  }
}
